{
  "name": "vynx-jailbreak",
  "version": "1.5.1",
  "description": "A local PS4 / PS5 WebKit jailbreak host with User Guide redirect and PSN/update blocking.",
  "main": "index.html",
  "scripts": {
    "build": "babel includes/js/index.js --out-file includes/js/index-legacy.js --presets=@babel/preset-env",
    "watch": "babel includes/js/index.js --out-file includes/js/index-legacy.js --presets=@babel/preset-env --watch"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.1",
    "@babel/core": "^7.24.1",
    "@babel/preset-env": "^7.24.1"
  }
}
